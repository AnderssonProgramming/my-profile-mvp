# ---- Browser (bundled into the public site) ----
# Optional live Roboflow detection in the webcam AI Coach.
# Use a PUBLISHABLE key (starts with rf_) — never your private API key here.
VITE_ROBOFLOW_KEY=
# Model id from the model page, e.g. the Universe basketball detector:
# VITE_ROBOFLOW_MODEL=basketball-detector-zfwmi/1
VITE_ROBOFLOW_MODEL=

# ---- Build-time only (scripts/analyze-court.mjs, never bundled) ----
# Private API key used to run the segmentation workflow on the court photo.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=ander-eci
ROBOFLOW_WORKFLOW=general-segmentation-api-2
